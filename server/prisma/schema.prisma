
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum TripStatus {
  PLANNING
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  TRANSPORT
  ACCOMMODATION
  FOOD
  ACTIVITIES
  SHOPPING
  OTHER
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips     Trip[]
  favorites Favorite[]
}

model Destination {
  id          String   @id @default(uuid())
  name        String
  country     String   @default("Sri Lanka")
  province    String?
  category    String?
  description String   @db.Text
  imageUrl    String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attractions Attraction[]
  trips       Trip[]
  favorites   Favorite[]

  @@index([name])
  @@index([country])
}

model Attraction {
  id            String   @id @default(uuid())
  name          String
  description   String?  @db.Text
  imageUrl      String?
  destinationId String
  createdAt     DateTime @default(now())

  destination Destination         @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  activities  ItineraryActivity[]
}

model Trip {
  id            String     @id @default(uuid())
  title         String
  startDate     DateTime
  endDate       DateTime
  travelers     Int        @default(1)
  budget        Float      @default(0)
  notes         String?    @db.Text
  status        TripStatus @default(PLANNING)
  userId        String
  destinationId String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination   @relation(fields: [destinationId], references: [id])
  days        ItineraryDay[]
  expenses    Expense[]

  @@index([userId])
  @@index([destinationId])
}

model ItineraryDay {
  id        String   @id @default(uuid())
  date      DateTime
  dayNumber Int
  tripId    String
  createdAt DateTime @default(now())

  trip       Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities ItineraryActivity[]

  @@unique([tripId, dayNumber])
}

model ItineraryActivity {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  startTime   String?
  endTime     String?
  location    String?
  dayId       String
  attractionId String?
  createdAt   DateTime @default(now())

  day        ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  attraction Attraction?  @relation(fields: [attractionId], references: [id], onDelete: SetNull)
}

model Expense {
  id          String          @id @default(uuid())
  title       String
  amount      Float
  category    ExpenseCategory @default(OTHER)
  description String?         @db.Text
  date        DateTime        @default(now())
  tripId      String
  createdAt   DateTime        @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Favorite {
  id            String   @id @default(uuid())
  userId        String
  destinationId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}
